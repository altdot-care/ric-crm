---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'RIC Sales CRM' } = Astro.props;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='16' fill='%23B5121B'/><text y='.9em' font-size='72' x='50%' text-anchor='middle'>R</text></svg>"
    />
  </head>
  <body class="bg-ric-gray-light font-sans text-ric-black min-h-screen">
    <slot />
  </body>
</html>
