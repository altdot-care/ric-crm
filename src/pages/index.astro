<script is:inline>
// ── State ──────────────────────────────────────────────────────────────────
let leads = [];
let activities = [];
let renewals = [];
let companies = [];
let contacts = [];
let nextActions = [];
let currentCompanyId = null;
let companyEditMode = false;
let currentLeadId = null;
let currentView = 'dashboard';
let me = null;
let profiles = [];

// ── Stage config ──────────────────────────────────────────────────────────
const STAGES = [
  { id: 'new', label: 'ลีดใหม่', color: 'bg-slate-100 text-slate-600' },
  { id: 'contacted', label: 'ติดต่อแล้ว', color: 'bg-blue-100 text-blue-700' },
  { id: 'quoted', label: 'เสนอราคา', color: 'bg-violet-100 text-violet-700' },
  { id: 'negotiating', label: 'เจรจา', color: 'bg-amber-100 text-amber-700' },
  { id: 'won', label: 'ปิดดีล ✓', color: 'bg-green-100 text-green-700' },
  { id: 'lost', label: 'ไม่สำเร็จ', color: 'bg-red-100 text-red-600' },
];

const ACT_TYPE_LABEL = { call: '📞 โทรศัพท์', email: '✉️ อีเมล', meeting: '🤝 ประชุม', note: '📝 บันทึก' };

// ── Helpers ────────────────────────────────────────────────────────────────
// All API data is user-supplied and rendered via innerHTML, so escape every value.
function esc(value) {
  return String(value ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

// root is an admin who can also delete and manage users.
function isAdmin() {
  return me?.role === 'admin' || me?.role === 'root';
}

function isRoot() {
  return me?.role === 'root';
}

// Everyone sees every row, but sales may only change their own (the database enforces this too).
function canEdit(row) {
  return isAdmin() || row.owner_id === me?.id;
}

// Only admins/root pick an owner; for sales the database defaults the owner to the caller.
function ownerField(id) {
  return isAdmin() ? { owner_id: document.getElementById(id).value } : {};
}

// ── API helpers ────────────────────────────────────────────────────────────
async function api(path, options = {}) {
  const res = await fetch(path, {
    headers: { 'Content-Type': 'application/json' },
    ...options,
  });
  if (res.status === 401) {
    window.location.href = '/login';
    throw new Error('Session expired');
  }
  if (!res.ok) {
    const body = await res.json().catch(() => null);
    throw new Error(body?.error ?? `API error ${res.status}`);
  }
  return res.json();
}

function setupOwnerPickers() {
  document.getElementById('me-name').textContent = me.full_name || '—';
  document.getElementById('me-role').textContent = me.role;
  const options = profiles.map(p => `<option value="${esc(p.id)}">${esc(p.full_name || p.id)}</option>`).join('');
  document.querySelectorAll('[data-owner-select]').forEach(el => { el.innerHTML = options; el.value = me.id; });
  document.querySelectorAll('[data-admin-only]').forEach(el => el.classList.toggle('hidden', !isAdmin()));
  document.querySelectorAll('[data-root-only]').forEach(el => el.classList.toggle('hidden', !isRoot()));
}

// ── Data loading ───────────────────────────────────────────────────────────
async function loadAll() {
  const [l, a, r, co, ct, na, who] = await Promise.all([
    api('/api/leads'),
    api('/api/activities'),
    api('/api/renewals'),
    api('/api/companies'),
    api('/api/contacts'),
    api('/api/next-actions'),
    api('/api/me'),
  ]);
  me = who.me;
  profiles = who.profiles;
  setupOwnerPickers();
  leads = l;
  activities = a;
  renewals = r;
  companies = co;
  contacts = ct;
  nextActions = na;
  renderAll();
}

// The auto stage-change log row (and any other activity side-effect of a mutation, e.g. a
// cascade-delete of a lead's activities) is written server-side, not by this client — so any
// mutation that can add/remove activity rows must refetch `activities`, not just the table it
// wrote directly. Called from onDrop, saveLead, and deleteLead.
async function refreshActivities() {
  activities = await api('/api/activities');
}

// ── Views ─────────────────────────────────────────────────────────────────
function showView(view) {
  currentView = view;
  document.querySelectorAll('[id^="view-"]').forEach(el => el.classList.add('hidden'));
  document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
  document.getElementById('view-' + view).classList.remove('hidden');
  document.getElementById('nav-' + view).classList.add('active');
  renderAll();
  if (view === 'users') loadUsers();
}

function renderAll() {
  if (currentView === 'dashboard') renderDashboard();
  if (currentView === 'pipeline') renderPipeline();
  if (currentView === 'renewals') renderRenewals();
  if (currentView === 'activities') renderActivities();
  if (currentView === 'companies') renderCompanies();
}

// Shared by the "กิจกรรม" feed (Phase 2) and the company-detail deals list: jump straight to
// a deal's edit modal from anywhere in the app.
function openDeal(id) {
  showView('pipeline');
  openLeadModal(id);
}

// ── Dashboard ─────────────────────────────────────────────────────────────
function renderDashboard() {
  const today = new Date();
  document.getElementById('today-date').textContent = today.toLocaleDateString('th-TH', {
    weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
  });

  const won = leads.filter(l => l.stage === 'won');
  const totalValue = leads.filter(l => l.stage !== 'lost').reduce((s, l) => s + (l.value || 0), 0);
  const renIn30 = renewals.filter(r => {
    const days = Math.ceil((new Date(r.expiry) - today) / 86400000);
    return days >= 0 && days <= 30;
  });

  document.getElementById('kpi-total').textContent = leads.length;
  document.getElementById('kpi-won').textContent = won.length;
  document.getElementById('kpi-value').textContent = totalValue.toLocaleString('th-TH');
  document.getElementById('kpi-renewals').textContent = renIn30.length;

  const recent = [...leads].slice(0, 6);
  document.getElementById('dash-recent-leads').innerHTML = recent.length
    ? recent.map(l => {
        const stage = STAGES.find(s => s.id === l.stage) || STAGES[0];
        return `<div class="flex items-center gap-3 px-5 py-3 hover:bg-gray-50 cursor-pointer" onclick="openLeadModal('${esc(l.id)}')">
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate">${esc(l.company?.name)}</p>
            <p class="text-xs text-ric-gray">${esc(l.cert?.join(', ')) || '—'} · ${esc(l.primary_contact?.full_name) || '—'}</p>
          </div>
          <span class="text-xs px-2 py-0.5 rounded-full ${stage.color}">${stage.label}</span>
          <span class="text-xs font-mono text-ric-gray">${(l.value || 0).toLocaleString('th-TH')} ฿</span>
        </div>`;
      }).join('')
    : '<p class="px-5 py-6 text-sm text-ric-gray text-center">ยังไม่มีลีด · <button onclick="openLeadModal()" class="text-ric-red hover:underline">เพิ่มลีดใหม่</button></p>';
}

// ── Pipeline ──────────────────────────────────────────────────────────────
function renderPipeline() {
  const board = document.getElementById('pipeline-board');
  board.innerHTML = STAGES.map(stage => {
    const cards = leads.filter(l => l.stage === stage.id);
    return `<div class="pipeline-col" data-stage="${stage.id}">
      <div class="pipeline-col-header flex items-center justify-between">
        <span>${stage.label}</span>
        <span class="bg-gray-200 text-ric-gray rounded-full px-2 py-0.5 text-[10px]">${cards.length}</span>
      </div>
      <div class="drop-zone flex-1 rounded-xl p-2 space-y-2 min-h-[120px] transition-colors"
        data-stage="${stage.id}"
        ondragover="onDragOver(event)"
        ondrop="onDrop(event)"
        ondragleave="onDragLeave(event)">
        ${cards.map(card => renderLeadCard(card)).join('')}
      </div>
    </div>`;
  }).join('');
}

function renderLeadCard(l) {
  // Pick the open (not completed) next_action with the nearest due date — nulls-due-date sort
  // last, since an undated item is less urgent than any dated one.
  const openActions = nextActions
    .filter(n => n.lead_id === l.id && !n.completed_at)
    .sort((a, b) => {
      if (!a.due_date && !b.due_date) return 0;
      if (!a.due_date) return 1;
      if (!b.due_date) return -1;
      return new Date(a.due_date) - new Date(b.due_date);
    });
  const picked = openActions[0];
  const overdue = picked?.due_date && daysUntil(picked.due_date) < 0;
  const dueLabel = picked?.due_date
    ? new Date(picked.due_date).toLocaleDateString('th-TH', { day: 'numeric', month: 'short' })
    : '';
  const nextActionHtml = picked
    ? `<p class="text-[11px] mt-2 px-2 py-1 rounded-md ${overdue ? 'bg-red-50 text-ric-red' : 'bg-amber-50 text-amber-700'}">🔔 ${esc(picked.description)}${dueLabel ? ` — ${overdue ? 'เลยกำหนด' : 'ครบกำหนด'} ${dueLabel}` : ''}</p>`
    : '';
  return `<div class="lead-card" draggable="${canEdit(l)}"
    data-id="${esc(l.id)}"
    ondragstart="onDragStart(event, '${esc(l.id)}')"
    ondragend="onDragEnd(event)"
    onclick="openLeadModal('${esc(l.id)}')">
    <p class="font-medium text-sm leading-tight mb-1">${esc(l.company?.name)}</p>
    <p class="text-xs text-ric-gray mb-2">${esc(l.cert?.join(', ')) || '—'}</p>
    <div class="flex items-center justify-between">
      <span class="text-xs text-ric-gray">${esc(l.primary_contact?.full_name) || '—'}${l.primary_contact?.position ? ` (${esc(l.primary_contact.position)})` : ''}</span>
      <span class="text-xs font-mono font-medium">${(l.value || 0).toLocaleString('th-TH')} ฿</span>
    </div>
    ${nextActionHtml}
    ${l.owner?.full_name ? `<p class="text-[10px] text-ric-gray/60 mt-1.5">👤 ${esc(l.owner.full_name)}</p>` : ''}
  </div>`;
}

// ── Drag & Drop ───────────────────────────────────────────────────────────
let draggingId = null;

function onDragStart(e, id) {
  draggingId = id;
  e.currentTarget.classList.add('dragging');
}

function onDragEnd(e) {
  e.currentTarget.classList.remove('dragging');
}

function onDragOver(e) {
  e.preventDefault();
  e.currentTarget.classList.add('drag-over');
}

function onDragLeave(e) {
  e.currentTarget.classList.remove('drag-over');
}

async function onDrop(e) {
  e.preventDefault();
  e.currentTarget.classList.remove('drag-over');
  const targetStage = e.currentTarget.dataset.stage;
  if (!draggingId || !targetStage) return;

  const lead = leads.find(l => l.id === draggingId);
  if (!lead || lead.stage === targetStage) return;

  const previousStage = lead.stage;
  lead.stage = targetStage;
  renderPipeline();
  try {
    await api(`/api/leads/${draggingId}`, {
      method: 'PUT',
      body: JSON.stringify({ stage: targetStage }),
    });
    // The stage change just fired a DB trigger that inserted a stage_change activity row —
    // refetch so the Log tab / activity feed show it without a full page reload.
    await refreshActivities();
  } catch (err) {
    lead.stage = previousStage;
    renderPipeline();
    alert('ย้าย stage ไม่สำเร็จ: ' + err.message);
  }
}

// ── Renewals ──────────────────────────────────────────────────────────────
function daysUntil(dateStr) {
  const today = new Date(); today.setHours(0,0,0,0);
  const d = new Date(dateStr);
  return Math.ceil((d - today) / 86400000);
}

function urgencyBadge(days) {
  if (days < 0) return `<span class="badge-urgent">⚠ เลยกำหนด ${Math.abs(days)} วัน</span>`;
  if (days <= 30) return `<span class="badge-urgent">⚠ ${days} วัน</span>`;
  if (days <= 90) return `<span class="badge-warning">🔔 ${days} วัน</span>`;
  return `<span class="badge-ok">✓ ${days} วัน</span>`;
}

function renderRenewals() {
  const sorted = [...renewals].sort((a, b) => new Date(a.audit_due) - new Date(b.audit_due));
  document.getElementById('renewals-list').innerHTML = sorted.length
    ? sorted.map(r => {
        return `<div class="bg-white rounded-xl p-4 shadow-xs border border-gray-100 flex items-center gap-4 cursor-pointer hover:bg-gray-50" onclick="openRenewalModal('${esc(r.id)}')">
          <div class="flex-1">
            <p class="font-medium text-sm">${esc(r.company?.name) || 'ไม่ระบุบริษัท'}</p>
            <p class="text-xs text-ric-gray mt-0.5">${esc(r.cert)}</p>
            ${r.owner?.full_name ? `<p class="text-xs text-ric-gray/60 mt-1">👤 ${esc(r.owner.full_name)}</p>` : ''}
          </div>
          <div class="flex flex-col gap-1 shrink-0">
            <div class="flex items-center gap-2">
              <span class="text-[11px] text-ric-gray w-12 text-right shrink-0">ตรวจ</span>
              ${urgencyBadge(daysUntil(r.audit_due))}
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[11px] text-ric-gray w-12 text-right shrink-0">หมดอายุ</span>
              ${urgencyBadge(daysUntil(r.expiry))}
            </div>
          </div>
        </div>`;
      }).join('')
    : '<div class="bg-white rounded-xl p-8 text-center text-sm text-ric-gray shadow-xs border border-gray-100">ยังไม่มีใบรับรอง · <button onclick="openRenewalModal()" class="text-ric-red hover:underline">เพิ่มใบรับรอง</button></div>';
}

// ── Activities ────────────────────────────────────────────────────────────
function renderActivities() {
