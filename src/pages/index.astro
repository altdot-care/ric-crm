// ── Renewal Modal ─────────────────────────────────────────────────────────
function openRenewalModal() {
  document.getElementById('modal-renewal').classList.remove('hidden');
}

function closeRenewalModal() {
  document.getElementById('modal-renewal').classList.add('hidden');
}

