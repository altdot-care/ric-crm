async function saveRenewal(e) {
  e.preventDefault();
  const id = document.getElementById('ren-id').value;

  // The typed text may or may not match an existing company — re-resolve here rather than
  // trusting the hidden field alone, in case the user typed after their last keystroke handler
  // ran (e.g. picked a datalist suggestion without a trailing input event in some browsers).
  const typedName = document.getElementById('ren-company-search').value.trim();
  if (!typedName) { alert('กรุณาพิมพ์ชื่อบริษัท'); return; }
  let companyId = companies.find(co => co.name === typedName)?.id || '';

  if (!companyId) {
    try {
      const created = await api('/api/companies', { method: 'POST', body: JSON.stringify({ name: typedName }) });
      companies.push(created);
      companyId = created.id;
    } catch (err) {
      alert('เพิ่มบริษัทไม่สำเร็จ: ' + err.message);
      return;
    }
  }

  const data = {
    company_id: companyId,
    cert: document.getElementById('ren-cert').value,
    audit_due: document.getElementById('ren-audit-due').value,
    expiry: document.getElementById('ren-expiry').value,
    ...ownerField('ren-owner'),
  };
  try {
    if (id) {
      await api(`/api/renewals/${id}`, { method: 'PUT', body: JSON.stringify(data) });
    } else {
      await api('/api/renewals', { method: 'POST', body: JSON.stringify(data) });
    }
    renewals = await api('/api/renewals');
  } catch (err) {
    alert('บันทึกไม่สำเร็จ: ' + err.message);
    return;
  }
  closeRenewalModal();
  renderAll();
}

async function deleteRenewal() {
  const id = document.getElementById('ren-id').value;
  if (!id || !confirm('ลบใบรับรองนี้ใช่ไหม?')) return;
  try {
    await api(`/api/renewals/${id}`, { method: 'DELETE' });
