// ── Users (root only) ─────────────────────────────────────────────────────
let users = [];

async function loadUsers() {
  try {
    users = await api('/api/users');
    renderUsers();
  } catch (err) {
    document.getElementById('users-list').innerHTML =
      `<div class="bg-white rounded-xl p-6 text-sm text-ric-gray shadow-xs border border-gray-100">โหลดรายชื่อผู้ใช้ไม่สำเร็จ: ${esc(err.message)}</div>`;
  }
}

function renderUsers() {
  document.getElementById('users-list').innerHTML = users.map(u => {
    const isSelf = u.id === me.id;
    const locked = u.role === 'root' || isSelf; // root and your own account cannot be changed or deleted here
    const roleControl = locked
      ? `<span class="text-xs font-mono uppercase text-ric-gray">${esc(u.role)}</span>`
      : `<select class="field-input !w-auto !py-1 text-xs" onchange="changeRole('${esc(u.id)}', this.value)">
           <option value="sales" ${u.role === 'sales' ? 'selected' : ''}>sales</option>
           <option value="admin" ${u.role === 'admin' ? 'selected' : ''}>admin</option>
         </select>`;
    const deleteBtn = locked ? '' : `<button onclick="deleteUser('${esc(u.id)}')" class="text-ric-gray hover:text-ric-red" title="ลบผู้ใช้">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>`;
    return `<div class="bg-white rounded-xl p-4 shadow-xs border border-gray-100 flex items-center gap-4">
      <div class="flex-1 min-w-0">
        <p class="font-medium text-sm truncate">${esc(u.full_name || '—')}${isSelf ? ' <span class="text-xs text-ric-gray">(คุณ)</span>' : ''}</p>
        <p class="text-xs text-ric-gray mt-0.5 font-mono truncate">${esc(u.email)}</p>
      </div>
      <div class="flex items-center gap-3">${roleControl}${deleteBtn}</div>
    </div>`;
  }).join('');
}

async function createUser(e) {
  e.preventDefault();
  const button = document.getElementById('user-submit');
  button.disabled = true;
  try {
    await api('/api/users', {
      method: 'POST',
      body: JSON.stringify({
        email: document.getElementById('user-email').value,
        full_name: document.getElementById('user-name').value,
        password: document.getElementById('user-password').value,
        role: document.getElementById('user-role').value,
      }),
    });
    document.getElementById('user-form').reset();
    await loadUsers();
    profiles = (await api('/api/me')).profiles; // keep the owner pickers in sync
    setupOwnerPickers();
  } catch (err) {
    alert('สร้างผู้ใช้ไม่สำเร็จ: ' + err.message);
  } finally {
    button.disabled = false;
  }
}

async function changeRole(id, role) {
  try {
    await api(`/api/users/${id}`, { method: 'PATCH', body: JSON.stringify({ role }) });
  } catch (err) {
    alert('เปลี่ยนสิทธิ์ไม่สำเร็จ: ' + err.message);
  }
  await loadUsers();
}

async function deleteUser(id) {
  const u = users.find(x => x.id === id);
  if (!u || !confirm(`ลบผู้ใช้ ${u.email} ใช่ไหม?\nข้อมูลลีด กิจกรรม และใบรับรองของเขาจะถูกโอนมาเป็นของคุณ`)) return;
  try {
    await api(`/api/users/${id}`, { method: 'DELETE' });
  } catch (err) {
    alert('ลบไม่สำเร็จ: ' + err.message);
    return;
  }
  await loadAll();
  await loadUsers();
}

// ── Init ──────────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', async () => {
  try {
    await loadAll();
    renderDashboard();
  } catch (err) {
    console.error('Failed to load data:', err);
    document.getElementById('view-dashboard').innerHTML = `
      <div class="p-8 text-center">
        <p class="text-ric-gray text-sm">ไม่สามารถโหลดข้อมูลได้ กรุณาลองใหม่อีกครั้ง</p>
        <p class="text-xs text-ric-gray/60 font-mono mt-1">${esc(err.message)}</p>
      </div>`;
  }
});
</script>
</div>
</Layout>
