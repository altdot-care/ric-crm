// Empty means "not collected" for these fields, so send null rather than ''.
function nullableInput(id) {
  return document.getElementById(id).value.trim() || null;
}

async function saveLead(e) {
  e.preventDefault();
  const id = document.getElementById('lead-id').value;

  // Validate both the new-company and new-contact names up front, before either POST fires —
  // otherwise a blank contact name (or any later failure) can leave a company already created
  // with no UI to remove it.
  let companyId = document.getElementById('lead-company-id').value;
  const creatingCompany = companyId === '__new__';
  const newCompanyName = creatingCompany ? document.getElementById('lead-new-company-name').value.trim() : '';
  if (creatingCompany && !newCompanyName) { alert('กรุณากรอกชื่อบริษัทใหม่'); return; }
  if (!creatingCompany && !companyId) { alert('กรุณาเลือกบริษัท'); return; }

  let contactId = document.getElementById('lead-contact-id').value;
  const creatingContact = contactId === '__new__';
  const newContactName = creatingContact ? document.getElementById('lead-new-contact-name').value.trim() : '';
  if (creatingContact && !newContactName) { alert('กรุณากรอกชื่อผู้ติดต่อใหม่'); return; }

  if (creatingCompany) {
    try {
      const created = await api('/api/companies', { method: 'POST', body: JSON.stringify({ name: newCompanyName }) });
      companies.push(created);
      companyId = created.id;
    } catch (err) {
      alert('เพิ่มบริษัทไม่สำเร็จ: ' + err.message);
      return;
    }
  }

  if (creatingContact) {
    try {
      const created = await api('/api/contacts', {
        method: 'POST',
        body: JSON.stringify({
          company_id: companyId,
          full_name: newContactName,
          position: document.getElementById('lead-new-contact-position').value,
        }),
      });
      contacts.push(created);
      contactId = created.id;
    } catch (err) {
      alert('เพิ่มผู้ติดต่อไม่สำเร็จ: ' + err.message);
      return;
    }
  }

  const data = {
    company_id: companyId,
    primary_contact_id: contactId || null,
    cert: getCertCheckboxes(),
    stage: document.getElementById('lead-stage').value,
    value: parseInt(document.getElementById('lead-value').value) || 0,
    // Only meaningful for the "เสนอราคา" stage, but harmless to keep if the stage changes later.
    quote_link: nullableInput('lead-quote-link'),
    notes: document.getElementById('lead-notes').value,
    ...ownerField('lead-owner'),
  };

  try {
    if (id) {
      await api(`/api/leads/${id}`, { method: 'PUT', body: JSON.stringify(data) });
    } else {
      await api('/api/leads', { method: 'POST', body: JSON.stringify(data) });
    }
    // A stage change (or any lead write) may have added an activity row server-side —
    // refetch both together so the Log tab / feed reflect it without a reload.
    [leads, activities] = await Promise.all([api('/api/leads'), api('/api/activities')]);
  } catch (err) {
    alert('บันทึกไม่สำเร็จ: ' + err.message);
    return;
  }

  closeLeadModal();
  renderAll();
}

async function deleteLead() {
  const id = document.getElementById('lead-id').value;
  if (!id || !confirm('ลบลีดนี้ใช่ไหม?')) return;
  try {
    await api(`/api/leads/${id}`, { method: 'DELETE' });
  } catch (err) {
    alert('ลบไม่สำเร็จ: ' + err.message);
    return;
  }
  // Deleting a lead cascade-deletes its activities and next_actions too — refetch all three
  // rather than filtering `leads` locally, so the activity feed and next-action list don't
  // keep showing rows for a lead that's gone.
  [leads, activities, nextActions] = await Promise.all([
    api('/api/leads'),
    api('/api/activities'),
    api('/api/next-actions'),
  ]);
  closeLeadModal();
  renderAll();
}

