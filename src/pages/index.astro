---
import Layout from '../layouts/Layout.astro';

export const prerender = false;
---

<Layout>
<div class="flex min-h-screen">

<!-- SIDEBAR -->
<aside id="sidebar" class="w-60 bg-ric-sidebar shrink-0 flex flex-col h-screen sticky top-0 overflow-hidden">
  <!-- Logo -->
  <div class="px-5 py-5 border-b border-white/5">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 bg-ric-red rounded-lg flex items-center justify-center font-bold text-white text-lg">R</div>
      <div>
        <p class="text-white font-semibold text-sm leading-tight">RIC</p>
        <p class="text-white/40 text-[10px] uppercase tracking-wider">Sales CRM</p>
      </div>
    </div>
  </div>

  <!-- Nav -->
  <nav class="flex-1 px-3 py-4 space-y-1">
    <button onclick="showView('dashboard')" class="nav-item active w-full text-left" id="nav-dashboard">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h18M3 12h18M3 17h18"/></svg>
      ภาพรวม
    </button>
    <button onclick="showView('pipeline')" class="nav-item w-full text-left" id="nav-pipeline">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/></svg>
      Pipeline
    </button>
    <button onclick="showView('renewals')" class="nav-item w-full text-left" id="nav-renewals">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      ต่ออายุใบรับรอง
    </button>
    <button onclick="showView('activities')" class="nav-item w-full text-left" id="nav-activities">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
      กิจกรรม
    </button>
  </nav>

  <!-- Bottom -->
  <div class="px-5 py-4 border-t border-white/5 space-y-3">
    <div>
      <p class="text-white text-xs font-medium truncate" id="me-name">—</p>
      <p class="text-white/40 text-[10px] uppercase tracking-wider" id="me-role"></p>
    </div>
    <form method="post" action="/api/auth/logout">
      <button type="submit" class="text-white/60 hover:text-white text-xs">ออกจากระบบ</button>
    </form>
    <p class="text-white/25 text-[10px] font-mono">Royal International Certification</p>
  </div>
</aside>

<!-- MAIN -->
<main class="flex-1 overflow-auto">
  <!-- DASHBOARD -->
  <div id="view-dashboard" class="p-6">
    <div class="mb-6">
      <h1 class="text-xl font-semibold text-ric-black">ภาพรวม Sales</h1>
      <p class="text-ric-gray text-sm mt-0.5" id="today-date"></p>
    </div>
    <!-- KPI Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
      <div class="bg-white rounded-xl p-4 shadow-xs border border-gray-100">
        <p class="text-xs text-ric-gray uppercase tracking-wider">ลีดทั้งหมด</p>
        <p class="text-3xl font-bold text-ric-black mt-1" id="kpi-total">—</p>
      </div>
      <div class="bg-white rounded-xl p-4 shadow-xs border border-gray-100">
        <p class="text-xs text-ric-gray uppercase tracking-wider">ปิดดีลแล้ว</p>
        <p class="text-3xl font-bold text-ric-red mt-1" id="kpi-won">—</p>
      </div>
      <div class="bg-white rounded-xl p-4 shadow-xs border border-gray-100">
        <p class="text-xs text-ric-gray uppercase tracking-wider">มูลค่ารวม</p>
        <p class="text-3xl font-bold text-ric-black mt-1" id="kpi-value">—</p>
      </div>
      <div class="bg-white rounded-xl p-4 shadow-xs border border-gray-100">
        <p class="text-xs text-ric-gray uppercase tracking-wider">ต่ออายุใน 30 วัน</p>
        <p class="text-3xl font-bold text-amber-600 mt-1" id="kpi-renewals">—</p>
      </div>
    </div>

    <!-- Recent Leads -->
    <div class="bg-white rounded-xl shadow-xs border border-gray-100">
      <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
        <h2 class="font-semibold text-sm">ลีดล่าสุด</h2>
        <button onclick="showView('pipeline')" class="text-xs text-ric-red hover:underline">ดู Pipeline →</button>
      </div>
      <div id="dash-recent-leads" class="divide-y divide-gray-50"></div>
    </div>
  </div>

  <!-- PIPELINE -->
  <div id="view-pipeline" class="hidden p-6">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-xl font-semibold">Pipeline</h1>
      <button onclick="openLeadModal()" class="btn-primary flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        เพิ่มลีดใหม่
      </button>
    </div>
    <div class="flex gap-4 overflow-x-auto pb-4" id="pipeline-board"></div>
  </div>

  <!-- RENEWALS -->
  <div id="view-renewals" class="hidden p-6">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-xl font-semibold">ต่ออายุใบรับรอง</h1>
      <button onclick="openRenewalModal()" class="btn-primary flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        เพิ่มใบรับรอง
      </button>
    </div>
    <div id="renewals-list" class="space-y-3"></div>
  </div>

  <!-- ACTIVITIES -->
  <div id="view-activities" class="hidden p-6">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-xl font-semibold">กิจกรรมและติดตาม</h1>
      <button onclick="openActivityModal()" class="btn-primary flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        บันทึกกิจกรรม
      </button>
    </div>
    <div id="activities-list" class="space-y-3"></div>
  </div>
</main>

<!-- MODAL: Lead -->
<div id="modal-lead" class="modal-overlay hidden" onclick="if(event.target===this)closeLeadModal()">
  <div class="modal-box">
    <div class="flex items-center justify-between p-5 border-b border-gray-100">
      <h3 class="font-semibold" id="lead-modal-title">เพิ่มลีดใหม่</h3>
      <button onclick="closeLeadModal()" class="text-ric-gray hover:text-ric-black">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <form id="lead-form" class="p-5 space-y-4" onsubmit="saveLead(event)">
      <input type="hidden" id="lead-id" />
      <div class="grid grid-cols-2 gap-4">
        <div class="col-span-2">
          <label class="field-label">ชื่อบริษัท *</label>
          <input class="field-input" id="lead-company" required placeholder="บริษัท ... จำกัด" />
        </div>
        <div>
          <label class="field-label">ผู้ติดต่อ</label>
          <input class="field-input" id="lead-contact" placeholder="ชื่อ-นามสกุล" />
        </div>
        <div>
          <label class="field-label">เบอร์โทร</label>
          <input class="field-input" id="lead-phone" placeholder="08x-xxx-xxxx" />
        </div>
        <div>
          <label class="field-label">อีเมล</label>
          <input class="field-input" id="lead-email" type="email" placeholder="name@company.com" />
        </div>
        <div>
          <label class="field-label">ใบรับรองที่สนใจ</label>
          <select class="field-input" id="lead-cert">
            <option value="">เลือกใบรับรอง</option>
            <option>ISO 9001</option>
            <option>ISO 14001</option>
            <option>ISO 45001</option>
            <option>ISO 27001</option>
            <option>ISO 22000</option>
            <option>GMP/HACCP</option>
            <option>อื่นๆ</option>
          </select>
        </div>
        <div>
          <label class="field-label">Stage</label>
          <select class="field-input" id="lead-stage">
            <option value="new">ลีดใหม่</option>
            <option value="contacted">ติดต่อแล้ว</option>
            <option value="quoted">เสนอราคา</option>
            <option value="negotiating">เจรจา</option>
            <option value="won">ปิดดีล ✓</option>
            <option value="lost">ไม่สำเร็จ</option>
          </select>
        </div>
        <div>
          <label class="field-label">มูลค่า (บาท)</label>
          <input class="field-input" id="lead-value" type="number" placeholder="0" min="0" />
        </div>
        <div data-admin-only class="hidden">
          <label class="field-label">ผู้รับผิดชอบ</label>
          <select class="field-input" data-owner-select id="lead-owner"></select>
        </div>
        <div class="col-span-2">
          <label class="field-label">หมายเหตุ</label>
          <textarea class="field-input h-20 resize-none" id="lead-notes" placeholder="รายละเอียดเพิ่มเติม..."></textarea>
        </div>
      </div>
      <div class="flex justify-between pt-2">
        <button type="button" id="lead-delete-btn" onclick="deleteLead()" class="btn-danger hidden">ลบลีดนี้</button>
        <div class="flex gap-2 ml-auto">
          <button type="button" onclick="closeLeadModal()" class="btn-secondary">ยกเลิก</button>
          <button type="submit" class="btn-primary">บันทึก</button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- MODAL: Activity -->
<div id="modal-activity" class="modal-overlay hidden" onclick="if(event.target===this)closeActivityModal()">
  <div class="modal-box">
    <div class="flex items-center justify-between p-5 border-b border-gray-100">
      <h3 class="font-semibold">บันทึกกิจกรรม</h3>
      <button onclick="closeActivityModal()" class="text-ric-gray hover:text-ric-black">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <form class="p-5 space-y-4" onsubmit="saveActivity(event)">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="field-label">ประเภท</label>
          <select class="field-input" id="act-type">
            <option value="call">📞 โทรศัพท์</option>
            <option value="email">✉️ อีเมล</option>
            <option value="meeting">🤝 ประชุม</option>
            <option value="note">📝 บันทึก</option>
          </select>
        </div>
        <div>
          <label class="field-label">วันที่</label>
          <input class="field-input" id="act-date" type="date" />
        </div>
        <div class="col-span-2">
          <label class="field-label">บริษัท</label>
          <input class="field-input" id="act-company" placeholder="ชื่อบริษัทลูกค้า" />
        </div>
        <div class="col-span-2">
          <label class="field-label">รายละเอียด *</label>
          <textarea class="field-input h-24 resize-none" id="act-description" required placeholder="สรุปการติดต่อ..."></textarea>
        </div>
        <div class="col-span-2">
          <label class="field-label">นัดติดตาม</label>
          <input class="field-input" id="act-followup" type="date" />
        </div>
        <div class="col-span-2 hidden" data-admin-only>
          <label class="field-label">บันทึกโดย</label>
          <select class="field-input" data-owner-select id="act-owner"></select>
        </div>
      </div>
      <div class="flex justify-end gap-2 pt-2">
        <button type="button" onclick="closeActivityModal()" class="btn-secondary">ยกเลิก</button>
        <button type="submit" class="btn-primary">บันทึก</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL: Renewal -->
<div id="modal-renewal" class="modal-overlay hidden" onclick="if(event.target===this)closeRenewalModal()">
  <div class="modal-box">
    <div class="flex items-center justify-between p-5 border-b border-gray-100">
      <h3 class="font-semibold">เพิ่มใบรับรอง</h3>
      <button onclick="closeRenewalModal()" class="text-ric-gray hover:text-ric-black">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <form class="p-5 space-y-4" onsubmit="saveRenewal(event)">
      <div class="grid grid-cols-2 gap-4">
        <div class="col-span-2">
          <label class="field-label">ชื่อบริษัท *</label>
          <input class="field-input" id="ren-company" required placeholder="บริษัท ... จำกัด" />
        </div>
        <div>
          <label class="field-label">ประเภทใบรับรอง *</label>
          <select class="field-input" id="ren-cert" required>
            <option value="">เลือก</option>
            <option>ISO 9001</option>
            <option>ISO 14001</option>
            <option>ISO 45001</option>
            <option>ISO 27001</option>
            <option>ISO 22000</option>
            <option>GMP/HACCP</option>
            <option>อื่นๆ</option>
          </select>
        </div>
        <div>
          <label class="field-label">วันหมดอายุ *</label>
          <input class="field-input" id="ren-expiry" type="date" required />
        </div>
        <div class="col-span-2 hidden" data-admin-only>
          <label class="field-label">เจ้าหน้าที่รับผิดชอบ</label>
          <select class="field-input" data-owner-select id="ren-owner"></select>
        </div>
      </div>
      <div class="flex justify-end gap-2 pt-2">
        <button type="button" onclick="closeRenewalModal()" class="btn-secondary">ยกเลิก</button>
        <button type="submit" class="btn-primary">บันทึก</button>
      </div>
    </form>
  </div>
</div>

<script is:inline>
// ── State ──────────────────────────────────────────────────────────────────
let leads = [];
let activities = [];
let renewals = [];
let currentView = 'dashboard';
let me = null;
let profiles = [];

// ── Stage config ──────────────────────────────────────────────────────────
const STAGES = [
  { id: 'new', label: 'ลีดใหม่', color: 'bg-slate-100 text-slate-600' },
  { id: 'contacted', label: 'ติดต่อแล้ว', color: 'bg-blue-100 text-blue-700' },
  { id: 'quoted', label: 'เสนอราคา', color: 'bg-violet-100 text-violet-700' },
  { id: 'negotiating', label: 'เจรจา', color: 'bg-amber-100 text-amber-700' },
  { id: 'won', label: 'ปิดดีล ✓', color: 'bg-green-100 text-green-700' },
  { id: 'lost', label: 'ไม่สำเร็จ', color: 'bg-red-100 text-red-600' },
];

const ACT_TYPE_LABEL = { call: '📞 โทรศัพท์', email: '✉️ อีเมล', meeting: '🤝 ประชุม', note: '📝 บันทึก' };

// ── Helpers ────────────────────────────────────────────────────────────────
// All API data is user-supplied and rendered via innerHTML, so escape every value.
function esc(value) {
  return String(value ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

function isAdmin() {
  return me?.role === 'admin';
}

// Only admins pick an owner; for sales the database defaults the owner to the caller.
function ownerField(id) {
  return isAdmin() ? { owner_id: document.getElementById(id).value } : {};
}

// ── API helpers ────────────────────────────────────────────────────────────
async function api(path, options = {}) {
  const res = await fetch(path, {
    headers: { 'Content-Type': 'application/json' },
    ...options,
  });
  if (res.status === 401) {
    window.location.href = '/login';
    throw new Error('Session expired');
  }
  if (!res.ok) throw new Error(`API error ${res.status}`);
  return res.json();
}

function setupOwnerPickers() {
  document.getElementById('me-name').textContent = me.full_name || '—';
  document.getElementById('me-role').textContent = me.role;
  const options = profiles.map(p => `<option value="${esc(p.id)}">${esc(p.full_name || p.id)}</option>`).join('');
  document.querySelectorAll('[data-owner-select]').forEach(el => { el.innerHTML = options; el.value = me.id; });
  document.querySelectorAll('[data-admin-only]').forEach(el => el.classList.toggle('hidden', !isAdmin()));
}

// ── Data loading ───────────────────────────────────────────────────────────
async function loadAll() {
  const [l, a, r, who] = await Promise.all([
    api('/api/leads'),
    api('/api/activities'),
    api('/api/renewals'),
    api('/api/me'),
  ]);
  me = who.me;
  profiles = who.profiles;
  setupOwnerPickers();
  leads = l;
  activities = a;
  renewals = r;
  renderAll();
}

// ── Views ─────────────────────────────────────────────────────────────────
function showView(view) {
  currentView = view;
  document.querySelectorAll('[id^="view-"]').forEach(el => el.classList.add('hidden'));
  document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
  document.getElementById('view-' + view).classList.remove('hidden');
  document.getElementById('nav-' + view).classList.add('active');
  renderAll();
}

function renderAll() {
  if (currentView === 'dashboard') renderDashboard();
  if (currentView === 'pipeline') renderPipeline();
  if (currentView === 'renewals') renderRenewals();
  if (currentView === 'activities') renderActivities();
}

// ── Dashboard ─────────────────────────────────────────────────────────────
function renderDashboard() {
  const today = new Date();
  document.getElementById('today-date').textContent = today.toLocaleDateString('th-TH', {
    weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
  });

  const won = leads.filter(l => l.stage === 'won');
  const totalValue = leads.filter(l => l.stage !== 'lost').reduce((s, l) => s + (l.value || 0), 0);
  const renIn30 = renewals.filter(r => {
    const days = Math.ceil((new Date(r.expiry) - today) / 86400000);
    return days >= 0 && days <= 30;
  });

  document.getElementById('kpi-total').textContent = leads.length;
  document.getElementById('kpi-won').textContent = won.length;
  document.getElementById('kpi-value').textContent = totalValue.toLocaleString('th-TH');
  document.getElementById('kpi-renewals').textContent = renIn30.length;

  const recent = [...leads].slice(0, 6);
  document.getElementById('dash-recent-leads').innerHTML = recent.length
    ? recent.map(l => {
        const stage = STAGES.find(s => s.id === l.stage) || STAGES[0];
        return `<div class="flex items-center gap-3 px-5 py-3 hover:bg-gray-50 cursor-pointer" onclick="openLeadModal('${esc(l.id)}')">
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate">${esc(l.company)}</p>
            <p class="text-xs text-ric-gray">${esc(l.cert) || '—'} · ${esc(l.contact) || '—'}</p>
          </div>
          <span class="text-xs px-2 py-0.5 rounded-full ${stage.color}">${stage.label}</span>
          <span class="text-xs font-mono text-ric-gray">${(l.value || 0).toLocaleString('th-TH')} ฿</span>
        </div>`;
      }).join('')
    : '<p class="px-5 py-6 text-sm text-ric-gray text-center">ยังไม่มีลีด · <button onclick="openLeadModal()" class="text-ric-red hover:underline">เพิ่มลีดใหม่</button></p>';
}

// ── Pipeline ──────────────────────────────────────────────────────────────
function renderPipeline() {
  const board = document.getElementById('pipeline-board');
  board.innerHTML = STAGES.map(stage => {
    const cards = leads.filter(l => l.stage === stage.id);
    return `<div class="pipeline-col" data-stage="${stage.id}">
      <div class="pipeline-col-header flex items-center justify-between">
        <span>${stage.label}</span>
        <span class="bg-gray-200 text-ric-gray rounded-full px-2 py-0.5 text-[10px]">${cards.length}</span>
      </div>
      <div class="drop-zone flex-1 rounded-xl p-2 space-y-2 min-h-[120px] transition-colors"
        data-stage="${stage.id}"
        ondragover="onDragOver(event)"
        ondrop="onDrop(event)"
        ondragleave="onDragLeave(event)">
        ${cards.map(card => renderLeadCard(card)).join('')}
      </div>
    </div>`;
  }).join('');
}

function renderLeadCard(l) {
  return `<div class="lead-card" draggable="true"
    data-id="${esc(l.id)}"
    ondragstart="onDragStart(event, '${esc(l.id)}')"
    ondragend="onDragEnd(event)"
    onclick="openLeadModal('${esc(l.id)}')">
    <p class="font-medium text-sm leading-tight mb-1">${esc(l.company)}</p>
    <p class="text-xs text-ric-gray mb-2">${esc(l.cert) || '—'}</p>
    <div class="flex items-center justify-between">
      <span class="text-xs text-ric-gray">${esc(l.contact) || '—'}</span>
      <span class="text-xs font-mono font-medium">${(l.value || 0).toLocaleString('th-TH')} ฿</span>
    </div>
    ${l.owner?.full_name ? `<p class="text-[10px] text-ric-gray/60 mt-1.5">👤 ${esc(l.owner.full_name)}</p>` : ''}
  </div>`;
}

// ── Drag & Drop ───────────────────────────────────────────────────────────
let draggingId = null;

function onDragStart(e, id) {
  draggingId = id;
  e.currentTarget.classList.add('dragging');
}

function onDragEnd(e) {
  e.currentTarget.classList.remove('dragging');
}

function onDragOver(e) {
  e.preventDefault();
  e.currentTarget.classList.add('drag-over');
}

function onDragLeave(e) {
  e.currentTarget.classList.remove('drag-over');
}

async function onDrop(e) {
  e.preventDefault();
  e.currentTarget.classList.remove('drag-over');
  const targetStage = e.currentTarget.dataset.stage;
  if (!draggingId || !targetStage) return;

  const lead = leads.find(l => l.id === draggingId);
  if (!lead || lead.stage === targetStage) return;

  const previousStage = lead.stage;
  lead.stage = targetStage;
  renderPipeline();
  try {
    await api(`/api/leads/${draggingId}`, {
      method: 'PUT',
      body: JSON.stringify({ stage: targetStage }),
    });
  } catch (err) {
    lead.stage = previousStage;
    renderPipeline();
    alert('ย้าย stage ไม่สำเร็จ: ' + err.message);
  }
}

// ── Renewals ──────────────────────────────────────────────────────────────
function daysUntil(dateStr) {
  const today = new Date(); today.setHours(0,0,0,0);
  const d = new Date(dateStr);
  return Math.ceil((d - today) / 86400000);
}

function urgencyBadge(days) {
  if (days < 0) return `<span class="badge-urgent">หมดอายุแล้ว</span>`;
  if (days <= 30) return `<span class="badge-urgent">⚠ ${days} วัน</span>`;
  if (days <= 90) return `<span class="badge-warning">🔔 ${days} วัน</span>`;
  return `<span class="badge-ok">✓ ${days} วัน</span>`;
}

function renderRenewals() {
  const sorted = [...renewals].sort((a, b) => new Date(a.expiry) - new Date(b.expiry));
  document.getElementById('renewals-list').innerHTML = sorted.length
    ? sorted.map(r => {
        const days = daysUntil(r.expiry);
        return `<div class="bg-white rounded-xl p-4 shadow-xs border border-gray-100 flex items-center gap-4">
          <div class="flex-1">
            <p class="font-medium text-sm">${esc(r.company)}</p>
            <p class="text-xs text-ric-gray mt-0.5 font-mono">${esc(r.cert)} · หมดอายุ ${esc(r.expiry)}</p>
            ${r.owner?.full_name ? `<p class="text-xs text-ric-gray/60 mt-1">👤 ${esc(r.owner.full_name)}</p>` : ''}
          </div>
          <div class="flex items-center gap-2">
            ${urgencyBadge(days)}
            <button onclick="deleteRenewal('${esc(r.id)}')" class="text-ric-gray hover:text-ric-red ml-2" title="ลบ">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>
        </div>`;
      }).join('')
    : '<div class="bg-white rounded-xl p-8 text-center text-sm text-ric-gray shadow-xs border border-gray-100">ยังไม่มีใบรับรอง · <button onclick="openRenewalModal()" class="text-ric-red hover:underline">เพิ่มใบรับรอง</button></div>';
}

// ── Activities ────────────────────────────────────────────────────────────
function renderActivities() {
  const sorted = [...activities].sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
  document.getElementById('activities-list').innerHTML = sorted.length
    ? sorted.map(a => `<div class="bg-white rounded-xl p-4 shadow-xs border border-gray-100">
        <div class="flex items-start justify-between gap-2">
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs bg-gray-100 px-2 py-0.5 rounded-sm">${esc(ACT_TYPE_LABEL[a.type] || a.type)}</span>
              <span class="text-xs font-mono text-ric-gray">${esc(a.date)}</span>
              ${a.company ? `<span class="text-xs text-ric-gray">· ${esc(a.company)}</span>` : ''}
            </div>
            <p class="text-sm">${esc(a.description)}</p>
            ${a.followup ? `<p class="text-xs text-amber-600 mt-1">🔔 นัดติดตาม: ${esc(a.followup)}</p>` : ''}
            ${a.owner?.full_name ? `<p class="text-xs text-ric-gray/60 mt-1">👤 ${esc(a.owner.full_name)}</p>` : ''}
          </div>
        </div>
      </div>`).join('')
    : '<div class="bg-white rounded-xl p-8 text-center text-sm text-ric-gray shadow-xs border border-gray-100">ยังไม่มีกิจกรรม · <button onclick="openActivityModal()" class="text-ric-red hover:underline">บันทึกกิจกรรมแรก</button></div>';
}

// ── Lead Modal ────────────────────────────────────────────────────────────
function openLeadModal(id = null) {
  const modal = document.getElementById('modal-lead');
  const deleteBtn = document.getElementById('lead-delete-btn');

  if (id) {
    const lead = leads.find(l => l.id === id);
    if (!lead) return;
    document.getElementById('lead-modal-title').textContent = 'แก้ไขลีด';
    document.getElementById('lead-id').value = lead.id;
    document.getElementById('lead-company').value = lead.company || '';
    document.getElementById('lead-contact').value = lead.contact || '';
    document.getElementById('lead-phone').value = lead.phone || '';
    document.getElementById('lead-email').value = lead.email || '';
    document.getElementById('lead-cert').value = lead.cert || '';
    document.getElementById('lead-stage').value = lead.stage || 'new';
    document.getElementById('lead-value').value = lead.value || '';
    document.getElementById('lead-owner').value = lead.owner_id;
    document.getElementById('lead-notes').value = lead.notes || '';
    deleteBtn.classList.remove('hidden');
  } else {
    document.getElementById('lead-modal-title').textContent = 'เพิ่มลีดใหม่';
    document.getElementById('lead-form').reset();
    document.getElementById('lead-id').value = '';
    document.getElementById('lead-owner').value = me.id;
    deleteBtn.classList.add('hidden');
  }

  modal.classList.remove('hidden');
}

function closeLeadModal() {
  document.getElementById('modal-lead').classList.add('hidden');
}

async function saveLead(e) {
  e.preventDefault();
  const id = document.getElementById('lead-id').value;
  const data = {
    company: document.getElementById('lead-company').value,
    contact: document.getElementById('lead-contact').value,
    phone: document.getElementById('lead-phone').value,
    email: document.getElementById('lead-email').value,
    cert: document.getElementById('lead-cert').value,
    stage: document.getElementById('lead-stage').value,
    value: parseInt(document.getElementById('lead-value').value) || 0,
    notes: document.getElementById('lead-notes').value,
    ...ownerField('lead-owner'),
  };

  try {
    if (id) {
      await api(`/api/leads/${id}`, { method: 'PUT', body: JSON.stringify(data) });
    } else {
      await api('/api/leads', { method: 'POST', body: JSON.stringify(data) });
    }
    leads = await api('/api/leads');
  } catch (err) {
    alert('บันทึกไม่สำเร็จ: ' + err.message);
    return;
  }

  closeLeadModal();
  renderAll();
}

async function deleteLead() {
  const id = document.getElementById('lead-id').value;
  if (!id || !confirm('ลบลีดนี้ใช่ไหม?')) return;
  try {
    await api(`/api/leads/${id}`, { method: 'DELETE' });
  } catch (err) {
    alert('ลบไม่สำเร็จ: ' + err.message);
    return;
  }
  leads = leads.filter(l => l.id !== id);
  closeLeadModal();
  renderAll();
}

// ── Activity Modal ────────────────────────────────────────────────────────
function openActivityModal() {
  document.getElementById('act-date').value = new Date().toISOString().slice(0, 10);
  document.getElementById('modal-activity').classList.remove('hidden');
}

function closeActivityModal() {
  document.getElementById('modal-activity').classList.add('hidden');
}

async function saveActivity(e) {
  e.preventDefault();
  const data = {
    type: document.getElementById('act-type').value,
    date: document.getElementById('act-date').value,
    company: document.getElementById('act-company').value,
    description: document.getElementById('act-description').value,
    followup: document.getElementById('act-followup').value,
    ...ownerField('act-owner'),
  };
  try {
    activities.unshift(await api('/api/activities', { method: 'POST', body: JSON.stringify(data) }));
  } catch (err) {
    alert('บันทึกไม่สำเร็จ: ' + err.message);
    return;
  }
  closeActivityModal();
  document.getElementById('modal-activity').querySelector('form').reset();
  document.getElementById('act-owner').value = me.id;
  renderAll();
}

// ── Renewal Modal ─────────────────────────────────────────────────────────
function openRenewalModal() {
  document.getElementById('modal-renewal').classList.remove('hidden');
}

function closeRenewalModal() {
  document.getElementById('modal-renewal').classList.add('hidden');
}

async function saveRenewal(e) {
  e.preventDefault();
  const data = {
    company: document.getElementById('ren-company').value,
    cert: document.getElementById('ren-cert').value,
    expiry: document.getElementById('ren-expiry').value,
    ...ownerField('ren-owner'),
  };
  try {
    renewals.push(await api('/api/renewals', { method: 'POST', body: JSON.stringify(data) }));
  } catch (err) {
    alert('บันทึกไม่สำเร็จ: ' + err.message);
    return;
  }
  closeRenewalModal();
  document.getElementById('modal-renewal').querySelector('form').reset();
  document.getElementById('ren-owner').value = me.id;
  renderAll();
}

async function deleteRenewal(id) {
  if (!confirm('ลบใบรับรองนี้ใช่ไหม?')) return;
  try {
    await api(`/api/renewals/${id}`, { method: 'DELETE' });
  } catch (err) {
    alert('ลบไม่สำเร็จ: ' + err.message);
    return;
  }
  renewals = renewals.filter(r => r.id !== id);
  renderAll();
}

