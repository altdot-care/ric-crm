// Composes the address block's separate columns into one readable line for the read-only view.
function formatCompanyAddress(company) {
  const line1 = [company.address1, company.address2].filter(Boolean).join(' ');
  const line2 = [company.sub_district, company.district, company.province, company.postcode].filter(Boolean).join(' ');
  return [line1, line2].filter(Boolean).join(', ');
}

// Sets a read-only view field's text, flagging an empty value as "รอใส่" in red instead of a
// blank dash — makes missing data something to notice, not something to miss.
function setViewField(id, value) {
  const el = document.getElementById(id);
  el.textContent = value || 'รอใส่';
  el.classList.toggle('text-ric-red', !value);
}

function renderCompanyDetail() {
  const company = companies.find(c => c.id === currentCompanyId);
  if (!company) { closeCompanyDetail(); return; }

  document.getElementById('company-edit-id').value = company.id;
  document.getElementById('company-edit-name').value = company.name || '';
  document.getElementById('company-edit-phone').value = company.phone || '';
  document.getElementById('company-edit-email').value = company.email || '';
