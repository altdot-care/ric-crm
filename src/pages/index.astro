---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

// RIC Certificate Auditor's service list — see template/ric-services.md.
const CERT_OPTIONS = [
  'ISO 9001', 'ISO 22000', 'ISO 22716', 'GHPs HACCP', 'GMP Codex', 'GMP อย.',
  'มกษ. 1004', 'มกษ. 4403', 'มกษ. 9023', 'มกษ. 9024', 'มกษ. 9035', 'มกษ. 9039',
  'มกษ. 9041', 'มกษ. 9046', 'มกษ. 9047', 'มกษ. 9070', 'มกษ. 4400', 'มกษ. 4401',
  'มกษ. 9001', 'มกษ. 3502', 'Organic', 'มกษ. 9000',
];
---

<Layout>
<div class="flex min-h-screen">

<!-- SIDEBAR -->
<aside id="sidebar" class="w-60 bg-ric-sidebar shrink-0 flex flex-col h-screen sticky top-0 overflow-hidden">
  <!-- Logo -->
  <div class="px-5 py-5 border-b border-white/5">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 bg-ric-red rounded-lg flex items-center justify-center font-bold text-white text-lg">R</div>
      <div>
        <p class="text-white font-semibold text-sm leading-tight">RIC</p>
        <p class="text-white/40 text-[10px] uppercase tracking-wider">Sales CRM</p>
      </div>
    </div>
  </div>

  <!-- Nav -->
  <nav class="flex-1 px-3 py-4 space-y-1">
    <button onclick="showView('dashboard')" class="nav-item active w-full text-left" id="nav-dashboard">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h18M3 12h18M3 17h18"/></svg>
      ภาพรวม
    </button>
    <button onclick="showView('pipeline')" class="nav-item w-full text-left" id="nav-pipeline">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/></svg>
      Pipeline
    </button>
    <button onclick="showView('renewals')" class="nav-item w-full text-left" id="nav-renewals">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      ต่ออายุใบรับรอง
    </button>
    <button onclick="showView('companies')" class="nav-item w-full text-left" id="nav-companies">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2M5 21H3m4-14h6M7 11h6M7 15h6"/></svg>
      บริษัท
    </button>
    <button onclick="showView('activities')" class="nav-item w-full text-left" id="nav-activities">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
      กิจกรรม
    </button>
    <button onclick="showView('users')" class="nav-item w-full text-left hidden" id="nav-users" data-root-only>
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m10-6.13a3 3 0 11-6 0 3 3 0 016 0zm-8 0a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      ผู้ใช้
    </button>
  </nav>

  <!-- Bottom -->
  <div class="px-5 py-4 border-t border-white/5 space-y-3">
    <div>
      <p class="text-white text-xs font-medium truncate" id="me-name">—</p>
      <p class="text-white/40 text-[10px] uppercase tracking-wider" id="me-role"></p>
    </div>
    <form method="post" action="/api/auth/logout">
      <button type="submit" class="text-white/60 hover:text-white text-xs">ออกจากระบบ</button>
    </form>
    <p class="text-white/25 text-[10px] font-mono">Royal International Certification</p>
  </div>
</aside>

<!-- MAIN -->
<main class="flex-1 overflow-auto">
  <!-- DASHBOARD -->
  <div id="view-dashboard" class="p-6">
    <div class="mb-6">
      <h1 class="text-xl font-semibold text-ric-black">ภาพรวม Sales</h1>
      <p class="text-ric-gray text-sm mt-0.5" id="today-date"></p>
    </div>
    <!-- KPI Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
      <div class="bg-white rounded-xl p-4 shadow-xs border border-gray-100">
        <p class="text-xs text-ric-gray uppercase tracking-wider">ลีดทั้งหมด</p>
        <p class="text-3xl font-bold text-ric-black mt-1" id="kpi-total">—</p>
      </div>
      <div class="bg-white rounded-xl p-4 shadow-xs border border-gray-100">
        <p class="text-xs text-ric-gray uppercase tracking-wider">ปิดดีลแล้ว</p>
        <p class="text-3xl font-bold text-ric-red mt-1" id="kpi-won">—</p>
      </div>
      <div class="bg-white rounded-xl p-4 shadow-xs border border-gray-100">
        <p class="text-xs text-ric-gray uppercase tracking-wider">มูลค่ารวม</p>
        <p class="text-3xl font-bold text-ric-black mt-1" id="kpi-value">—</p>
      </div>
      <div class="bg-white rounded-xl p-4 shadow-xs border border-gray-100">
        <p class="text-xs text-ric-gray uppercase tracking-wider">ต่ออายุใน 30 วัน</p>
        <p class="text-3xl font-bold text-amber-600 mt-1" id="kpi-renewals">—</p>
      </div>
    </div>

    <!-- Recent Leads -->
    <div class="bg-white rounded-xl shadow-xs border border-gray-100">
      <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
        <h2 class="font-semibold text-sm">ลีดล่าสุด</h2>
        <button onclick="showView('pipeline')" class="text-xs text-ric-red hover:underline">ดู Pipeline →</button>
      </div>
      <div id="dash-recent-leads" class="divide-y divide-gray-50"></div>
    </div>
  </div>

  <!-- PIPELINE -->
  <div id="view-pipeline" class="hidden p-6">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-xl font-semibold">Pipeline</h1>
      <button onclick="openLeadModal()" class="btn-primary flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        เพิ่มลีดใหม่
      </button>
    </div>
    <div class="flex gap-4 overflow-x-auto pb-4" id="pipeline-board"></div>
  </div>

  <!-- RENEWALS -->
  <div id="view-renewals" class="hidden p-6">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-xl font-semibold">ต่ออายุใบรับรอง</h1>
      <button onclick="openRenewalModal()" class="btn-primary flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        เพิ่มใบรับรอง
      </button>
    </div>
    <div id="renewals-list" class="space-y-3"></div>
  </div>

  <!-- COMPANIES -->
  <div id="view-companies" class="hidden p-6">
    <div class="flex items-center justify-between gap-4 mb-6">
      <h1 class="text-xl font-semibold shrink-0">บริษัท</h1>
      <input class="field-input flex-1 max-w-md" id="company-search" placeholder="ค้นหาบริษัท..." oninput="renderCompanies()" />
      <button onclick="openCompanyModal()" class="btn-primary shrink-0">+ เพิ่มบริษัท</button>
    </div>
    <div id="companies-list" class="space-y-3"></div>
  </div>

  <!-- COMPANY DETAIL -->
  <div id="view-company-detail" class="hidden p-6">
    <button onclick="closeCompanyDetail()" class="text-sm text-ric-gray hover:text-ric-black mb-4">← กลับ</button>
    <h1 class="text-xl font-semibold mb-4" id="company-detail-title">รายละเอียดบริษัท</h1>

    <div class="flex border-b border-gray-200 mb-6">
      <button type="button" onclick="switchCompanyTab('info')" id="company-tab-btn-info" class="px-3 py-2.5 text-sm font-medium border-b-2 border-ric-red text-ric-red">ข้อมูล</button>
      <button type="button" onclick="switchCompanyTab('contacts')" id="company-tab-btn-contacts" class="px-3 py-2.5 text-sm font-medium border-b-2 border-transparent text-ric-gray hover:text-ric-black">ผู้ติดต่อ</button>
      <button type="button" onclick="switchCompanyTab('deals')" id="company-tab-btn-deals" class="px-3 py-2.5 text-sm font-medium border-b-2 border-transparent text-ric-gray hover:text-ric-black">ดีล</button>
    </div>

    <div id="company-tab-info">
    <div class="flex justify-between items-center mb-3">
      <button type="button" id="company-delete-btn" onclick="deleteCompany()" class="btn-danger text-xs px-3 py-1.5 hidden">ลบบริษัทนี้</button>
      <button type="button" id="company-edit-toggle-btn" onclick="enableCompanyEdit()" class="btn-secondary text-xs px-3 py-1.5 hidden">แก้ไข</button>
    </div>

    <div id="company-view-info" class="bg-white rounded-xl p-5 shadow-xs border border-gray-100 mb-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
        <div><span class="text-ric-gray">ชื่อบริษัท:</span> <span class="font-medium" id="company-view-name">—</span></div>
        <div><span class="text-ric-gray">อีเมล:</span> <span id="company-view-email">—</span></div>
        <div><span class="text-ric-gray">เบอร์โทร:</span> <span id="company-view-phone">—</span></div>
        <div><span class="text-ric-gray">เว็บไซต์:</span> <span id="company-view-website">—</span></div>
        <div><span class="text-ric-gray">เลขประจำตัวผู้เสียภาษี:</span> <span id="company-view-tax-id">—</span></div>
        <div class="sm:col-span-2 pt-1 border-t border-gray-100"></div>
        <div class="sm:col-span-2"><span class="text-ric-gray">ที่อยู่:</span> <span id="company-view-address">—</span></div>
        <div class="sm:col-span-2"><span class="text-ric-gray">หมายเหตุ:</span> <span id="company-view-notes" class="whitespace-pre-wrap">—</span></div>
      </div>
    </div>

    <form id="company-detail-form" class="hidden bg-white rounded-xl p-5 shadow-xs border border-gray-100 mb-6" onsubmit="saveCompany(event)">
      <input type="hidden" id="company-edit-id" />
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="sm:col-span-2">
          <label class="field-label">ชื่อบริษัท *</label>
          <input class="field-input" id="company-edit-name" required placeholder="บริษัท ... จำกัด" />
        </div>
        <div>
          <label class="field-label">เบอร์โทร</label>
          <input class="field-input" id="company-edit-phone" type="tel" inputmode="numeric" pattern="[0-9]*" maxlength="10" oninput="this.value = this.value.replace(/\D/g, '').slice(0, 10)" placeholder="0812345678" />
        </div>
        <div>
          <label class="field-label">อีเมล</label>
          <input class="field-input" id="company-edit-email" type="email" placeholder="name@company.com" />
        </div>
        <div>
          <label class="field-label">เลขประจำตัวผู้เสียภาษี</label>
          <input class="field-input" id="company-edit-tax-id" maxlength="20" placeholder="13 หลัก" />
        </div>
        <div>
          <label class="field-label">เว็บไซต์</label>
          <input class="field-input" id="company-edit-website" type="url" placeholder="https://..." />
        </div>
        <div class="sm:col-span-2 pt-2 border-t border-gray-100">
          <p class="text-xs font-semibold text-ric-gray uppercase tracking-wider">ที่อยู่ (ไม่บังคับ)</p>
        </div>
        <div>
          <label class="field-label">รหัสไปรษณีย์</label>
          <input class="field-input" id="company-postcode" placeholder="10xxx" inputmode="numeric" pattern="[0-9]*" maxlength="5" oninput="onPostcodeInput('company')" />
        </div>
        <div>
          <label class="field-label">ตำบล/แขวง</label>
          <select class="field-input disabled:bg-gray-50 disabled:text-ric-gray" id="company-sub-district" onchange="onSubDistrictChange('company')" disabled>
            <option value="">-- กรอกรหัสไปรษณีย์ก่อน --</option>
          </select>
        </div>
        <div>
          <label class="field-label">อำเภอ/เขต</label>
          <input class="field-input bg-gray-50" id="company-district" readonly placeholder="อัตโนมัติจากตำบล" />
        </div>
        <div>
          <label class="field-label">จังหวัด</label>
          <input class="field-input bg-gray-50" id="company-province" readonly placeholder="อัตโนมัติจากตำบล" />
        </div>
        <div class="sm:col-span-2">
          <label class="field-label">ที่อยู่ 1</label>
          <input class="field-input" id="company-edit-address1" placeholder="บ้านเลขที่ ถนน" />
        </div>
        <div class="sm:col-span-2">
          <label class="field-label">ที่อยู่ 2</label>
          <input class="field-input" id="company-edit-address2" placeholder="หมู่บ้าน/อาคาร (ถ้ามี)" />
        </div>
        <div class="sm:col-span-2">
          <label class="field-label">หมายเหตุ</label>
          <textarea class="field-input" id="company-edit-notes" rows="2" placeholder="รายละเอียดเพิ่มเติม"></textarea>
        </div>
      </div>
      <div class="flex justify-end gap-2 pt-4">
        <button type="button" id="company-cancel-btn" onclick="cancelCompanyEdit()" class="btn-secondary">ยกเลิก</button>
        <button type="submit" id="company-save-btn" class="btn-primary">บันทึก</button>
      </div>
    </form>
    </div>

    <div id="company-tab-contacts" class="hidden">
      <div class="flex items-center justify-between mb-3">
        <h2 class="font-semibold text-sm">ผู้ติดต่อ</h2>
        <button onclick="openContactModal()" class="btn-primary text-xs px-3 py-1.5">+ เพิ่มผู้ติดต่อ</button>
      </div>
      <div id="company-contacts-list" class="space-y-2"></div>
    </div>

    <div id="company-tab-deals" class="hidden">
      <h2 class="font-semibold text-sm mb-3">ดีลของบริษัทนี้</h2>
      <div id="company-deals-list" class="bg-white rounded-xl shadow-xs border border-gray-100 divide-y divide-gray-50"></div>
    </div>
  </div>

  <!-- ACTIVITIES -->
  <div id="view-activities" class="hidden p-6">
    <div class="mb-6">
      <h1 class="text-xl font-semibold">กิจกรรมและติดตาม</h1>
      <p class="text-ric-gray text-sm mt-0.5">ทุกดีล อ่านอย่างเดียว — กดแถวเพื่อเปิดดีลนั้น เพิ่มบันทึกใหม่ได้จากในดีล (แท็บ Log)</p>
    </div>
    <div id="activities-list" class="space-y-3"></div>
  </div>

  <!-- USERS (root only) -->
  <div id="view-users" class="hidden p-6">
    <div class="mb-6">
      <h1 class="text-xl font-semibold">จัดการผู้ใช้</h1>
      <p class="text-ric-gray text-sm mt-0.5">เฉพาะ root · สร้างผู้ใช้พร้อมรหัสผ่าน เปลี่ยนสิทธิ์ และลบผู้ใช้</p>
    </div>
    <form id="user-form" class="bg-white rounded-xl p-5 shadow-xs border border-gray-100 grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6" onsubmit="createUser(event)">
      <div>
        <label class="field-label">อีเมล *</label>
        <input class="field-input" id="user-email" type="email" required autocomplete="off" placeholder="name@ricroyal.co.th" />
      </div>
      <div>
        <label class="field-label">ชื่อที่แสดง *</label>
        <input class="field-input" id="user-name" required placeholder="ชื่อ-นามสกุล" />
      </div>
      <div>
        <label class="field-label">รหัสผ่าน * (อย่างน้อย 8 ตัวอักษร)</label>
        <input class="field-input" id="user-password" type="password" required minlength="8" maxlength="72" autocomplete="new-password" />
      </div>
      <div>
        <label class="field-label">สิทธิ์</label>
        <select class="field-input" id="user-role">
          <option value="sales">sales — แก้ไขได้เฉพาะของตัวเอง ลบไม่ได้</option>
          <option value="admin">admin — แก้ไขได้ทุกอย่าง ลบไม่ได้</option>
        </select>
      </div>
      <div class="sm:col-span-2 flex justify-end">
        <button type="submit" class="btn-primary" id="user-submit">สร้างผู้ใช้</button>
      </div>
    </form>
    <div id="users-list" class="space-y-3"></div>
  </div>
</main>

<!-- MODAL: Lead -->
<div id="modal-lead" class="modal-overlay hidden" onclick="if(event.target===this)closeLeadModal()">
  <div class="modal-box">
    <div class="flex items-center justify-between p-5 border-b border-gray-100">
      <h3 class="font-semibold" id="lead-modal-title">เพิ่มลีดใหม่</h3>
      <button onclick="closeLeadModal()" class="text-ric-gray hover:text-ric-black">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="flex border-b border-gray-100 px-5">
      <button type="button" onclick="switchLeadTab('info')" id="lead-tab-btn-info" class="px-3 py-2.5 text-sm font-medium border-b-2 border-ric-red text-ric-red">ข้อมูล</button>
      <button type="button" onclick="switchLeadTab('log')" id="lead-tab-btn-log" class="px-3 py-2.5 text-sm font-medium border-b-2 border-transparent text-ric-gray hover:text-ric-black hidden">Log</button>
    </div>
    <div id="lead-tab-info">
    <form id="lead-form" class="p-5 space-y-4" onsubmit="saveLead(event)">
      <input type="hidden" id="lead-id" />
      <div class="grid grid-cols-2 gap-4">
        <div class="col-span-2">
          <label class="field-label">บริษัท *</label>
          <select class="field-input" id="lead-company-id" required onchange="onLeadCompanyChange()">
            <option value="">-- เลือกบริษัท --</option>
          </select>
        </div>
        <div class="col-span-2 hidden" id="lead-new-company-wrap">
          <label class="field-label">ชื่อบริษัทใหม่</label>
          <input class="field-input" id="lead-new-company-name" placeholder="บริษัท ... จำกัด" />
        </div>
        <div>
          <label class="field-label">ผู้ติดต่อหลัก</label>
          <select class="field-input" id="lead-contact-id" onchange="onLeadContactChange()">
            <option value="">-- ไม่ระบุ --</option>
          </select>
        </div>
        <div class="hidden" id="lead-new-contact-wrap">
          <label class="field-label">ผู้ติดต่อใหม่</label>
          <input class="field-input mb-2" id="lead-new-contact-name" placeholder="ชื่อ-นามสกุล" />
          <input class="field-input" id="lead-new-contact-position" placeholder="ตำแหน่ง (ไม่บังคับ)" />
        </div>
        <div class="col-span-2">
          <label class="field-label">ใบรับรองที่สนใจ (เลือกได้หลายรายการ)</label>
          <div id="lead-cert" class="field-input h-32 overflow-y-auto space-y-1.5">
            {CERT_OPTIONS.map((c) => (
              <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" value={c} class="rounded-sm border-gray-300 text-ric-red focus:ring-ric-red" />
                {c}
              </label>
            ))}
          </div>
        </div>
        <div>
          <label class="field-label">Stage</label>
          <select class="field-input" id="lead-stage" onchange="onStageChange()">
            <option value="new">ลีดใหม่</option>
            <option value="contacted">ติดต่อแล้ว</option>
            <option value="quoted">เสนอราคา</option>
            <option value="negotiating">เจรจา</option>
            <option value="won">ปิดดีล ✓</option>
            <option value="lost">ไม่สำเร็จ</option>
          </select>
        </div>
        <div>
          <label class="field-label">มูลค่า (บาท)</label>
          <input class="field-input" id="lead-value" type="number" placeholder="0" min="0" />
        </div>
        <div class="col-span-2 hidden" id="lead-quote-link-wrap">
          <label class="field-label">ลิงก์ใบเสนอราคา</label>
          <input class="field-input" id="lead-quote-link" type="url" placeholder="https://..." />
        </div>
