dist/
.astro/

# ── Cloudflare / Wrangler ────────────────────────────────────────────────────
.wrangler/
.mf/
# generated by `wrangler types`
worker-configuration.d.ts

# ── Secrets — never commit; .dev.vars.example / .env.example are the templates ─
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example
.env.keys
*.pem
*.key

# ── Supabase CLI (in case supabase/ lives inside the repo) ───────────────────
supabase/.temp/
supabase/.branches/
supabase/.env*

# ── Dependencies / package manager ───────────────────────────────────────────
node_modules/
.pnpm-store/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── TypeScript / tests ───────────────────────────────────────────────────────
*.tsbuildinfo
coverage/

# ── Editors / OS / tooling ───────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
.claude/settings.local.json
*.log
